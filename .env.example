# Public site URL (used for metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Claude API key for the AI Business Analyser (server-only). Without it the
# analyser falls back to its built-in rules engine.
ANTHROPIC_API_KEY=

# Email via Resend: sends analyser estimates to clients + team notifications.
# LEAD_NOTIFICATION_FROM must be on a domain verified in Resend, e.g. "Nerologik <hello@nerologik.com>".
RESEND_API_KEY=
LEAD_NOTIFICATION_TO=kwabenacrys@gmail.com
LEAD_NOTIFICATION_FROM="Nerologik <notifications@nerologik.com>"

# Booking embed (Phase 4/5) — Cal.com username/event, e.g. nerologik/intro-call
NEXT_PUBLIC_CAL_LINK=

# Vercel Cron: protects /api/research/reminder (any long random string).
CRON_SECRET=

# Optional: a team code people must enter to create an RIT account at /rit.
# Leave empty to let anyone with the link sign up.
RIT_INVITE_CODE=
